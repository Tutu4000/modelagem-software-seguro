# Atalhos do ambiente local. Funciona no Linux, no macOS e no Windows: cada
# receita usa só docker e go, um comando por linha.

set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

compose := "docker compose -f deploy/compose.yaml"

default:
    @just --list

# Gera os segredos em secrets/ (use `just secrets -force` para regerar)
secrets *args:
    go run ./cmd/gensecrets {{ args }}

# Sobe o ambiente, reconstruindo as imagens
up:
    {{ compose }} up -d --build

down:
    {{ compose }} down

# Apaga também os volumes: bancos, fila e arquivos
reset:
    {{ compose }} down -v

# Muda o número de réplicas da API
scale n="3":
    {{ compose }} up -d --no-recreate --scale api={{ n }}

ps:
    {{ compose }} ps

logs service="":
    {{ compose }} logs -f {{ service }}

# Imprime um token de teste: who é "a", "b" ou um UUID
token who="a" ttl="15m":
    go run ./cmd/devtoken -sub {{ who }} -ttl {{ ttl }}

# Envia STLs fictícios dos clientes A e B pela API pública
seed:
    go run ./cmd/seed

test:
    go test ./...

# Testes de ponta a ponta contra o ambiente do compose (precisa de `just up`)
test-e2e:
    go test -tags e2e -count=1 ./tests/e2e/...

# go vet, gosec, govulncheck e gitleaks (no histórico do git), com versões fixadas
lint:
    go vet ./...
    go run github.com/securego/gosec/v2/cmd/gosec@v2.30.0 -quiet ./...
    go run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./...
    docker run --rm -v "{{ justfile_directory() }}/../..:/repo:ro" ghcr.io/gitleaks/gitleaks:v8.30.1 git /repo --no-banner

# Varredura do ZAP pelo openapi.yaml, autenticada como o cliente A (Etapa 5)
zap:
    go run ./cmd/devtoken -sub a -ttl 2h -out secrets/zap_token
    {{ compose }} --profile zap run --rm zap
