#!/usr/bin/env bash
# Local CI, run by git before every push (enable it once with `just hooks`).
# - the push touches codigo/: `just ci` (lint, web checks, unit tests)
# - the push only touches docs, diagrams or scripts: only `just gitleaks`
# `SKIP_CI=1 git push` skips it, and so does `git push --no-verify`.
set -euo pipefail

if [ "${SKIP_CI:-}" = "1" ]; then
    echo "pre-push: SKIP_CI=1, skipping the local CI" >&2
    exit 0
fi

zero=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel)
touches_code=0
pushes_something=0

while read -r _ local_sha _ remote_sha; do
    # A deleted branch has nothing to check.
    [ "$local_sha" = "$zero" ] && continue
    pushes_something=1
    if [ "$remote_sha" = "$zero" ]; then
        # New branch: compare with main (or the whole history if there is no main).
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
        range=${base:+$base..}$local_sha
    else
        range=$remote_sha..$local_sha
    fi
    if git diff --name-only "$range" 2>/dev/null | grep -q '^codigo/'; then
        touches_code=1
    fi
done

[ "$pushes_something" = "1" ] || exit 0

cd "$root/codigo/etapa-4"
if [ "$touches_code" = "1" ]; then
    echo "pre-push: codigo/ changed, running 'just ci'" >&2
    just ci || { echo "pre-push: 'just ci' failed. Fix it, or push with SKIP_CI=1." >&2; exit 1; }
else
    echo "pre-push: no change in codigo/, running 'just gitleaks' only" >&2
    just gitleaks || { echo "pre-push: gitleaks failed. Fix it, or push with SKIP_CI=1." >&2; exit 1; }
fi
